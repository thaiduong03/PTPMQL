@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Sửa sinh viên";
    var hasKhoas = ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.KhoaId).Any();
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-warning">
                <h1 class="h4 mb-0">Sửa thông tin sinh viên</h1>
            </div>
            <div class="card-body">
                <p class="text-muted">Mã sinh viên và thông tin cấu thành mã được giữ nguyên.</p>
                @if (!hasKhoas)
                {
                    <div class="alert alert-warning" role="alert">Hiện không có khoa để chọn.</div>
                }

                <form asp-action="Edit" asp-route-id="@Model.MaSinhVien" method="post">
                    <input type="hidden" asp-for="MaSinhVien" />
                    <input type="hidden" asp-for="NamNhapHoc" />
                    <input type="hidden" asp-for="MaHeDaoTao" />
                    <input type="hidden" asp-for="MaNganh" />
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label"></label>
                        <input asp-for="HoTen" class="form-control" autocomplete="name" />
                        <span asp-validation-for="HoTen" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="KhoaId" class="form-label"></label>
                        <select asp-for="KhoaId" asp-items="ViewBag.KhoaId" class="form-select" disabled="@(!hasKhoas)">
                            <option value="">-- Chọn khoa --</option>
                        </select>
                        <span asp-validation-for="KhoaId" class="text-danger"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary" disabled="@(!hasKhoas)">Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
