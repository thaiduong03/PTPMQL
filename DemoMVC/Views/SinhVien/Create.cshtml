@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Thêm sinh viên";
    var hasKhoas = ((IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.KhoaId).Any();
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white">
                <h1 class="h4 mb-0">Thêm sinh viên</h1>
            </div>
            <div class="card-body">
                <p class="text-muted">Mã sinh viên được tự động tạo từ năm nhập học, hệ đào tạo, ngành và số thứ tự.</p>

                @if (!hasKhoas)
                {
                    <div class="alert alert-warning" role="alert">
                        Chưa có khoa để chọn. <a asp-controller="Khoa" asp-action="Create" class="alert-link">Thêm khoa trước</a>.
                    </div>
                }

                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="HoTen" class="form-label"></label>
                        <input asp-for="HoTen" class="form-control" autocomplete="name" />
                        <span asp-validation-for="HoTen" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NamNhapHoc" class="form-label"></label>
                        <input asp-for="NamNhapHoc" class="form-control" type="number" />
                        <span asp-validation-for="NamNhapHoc" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MaHeDaoTao" class="form-label"></label>
                        <input asp-for="MaHeDaoTao" class="form-control" maxlength="2" inputmode="numeric" placeholder="Ví dụ: 21" />
                        <span asp-validation-for="MaHeDaoTao" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="MaNganh" class="form-label"></label>
                        <input asp-for="MaNganh" class="form-control" maxlength="2" inputmode="numeric" placeholder="Ví dụ: 05" />
                        <span asp-validation-for="MaNganh" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="KhoaId" class="form-label"></label>
                        <select asp-for="KhoaId" asp-items="ViewBag.KhoaId" class="form-select" disabled="@(!hasKhoas)">
                            <option value="">-- Chọn khoa --</option>
                        </select>
                        <span asp-validation-for="KhoaId" class="text-danger"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-success" disabled="@(!hasKhoas)">Tạo sinh viên</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
