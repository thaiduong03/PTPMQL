@model DemoMVC.Models.SinhVien

@{
    ViewData["Title"] = "Xóa sinh viên";
}

<div class="row justify-content-center">
    <div class="col-md-9 col-lg-7">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h1 class="h4 mb-0">Xóa sinh viên</h1>
            </div>
            <div class="card-body">
                <div class="alert alert-warning" role="alert">
                    Bạn có chắc chắn muốn xóa sinh viên này không? Thao tác này không thể hoàn tác.
                </div>

                <dl class="row">
                    <dt class="col-sm-3">Mã sinh viên</dt>
                    <dd class="col-sm-9">@Model.MaSinhVien</dd>
                    <dt class="col-sm-3">Họ và tên</dt>
                    <dd class="col-sm-9">@Model.HoTen</dd>
                    <dt class="col-sm-3">Khoa</dt>
                    <dd class="col-sm-9">@(Model.Khoa?.TenKhoa ?? "Không xác định")</dd>
                </dl>

                <form asp-action="Delete" asp-route-id="@Model.MaSinhVien" method="post">
                    <input type="hidden" name="id" value="@Model.MaSinhVien" />
                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại danh sách</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
