@model DemoMVC.Models.SinhVien
@{ ViewData["Title"] = "Xóa sinh viên"; }
<h1>Xóa sinh viên</h1><div class="alert alert-warning">Bạn có chắc muốn xóa sinh viên này?</div>
<dl class="row"><dt class="col-sm-3">Mã sinh viên</dt><dd class="col-sm-9">@Model.MaSinhVien</dd><dt class="col-sm-3">Họ và tên</dt><dd class="col-sm-9">@Model.HoTen</dd><dt class="col-sm-3">Khoa</dt><dd class="col-sm-9">@Model.Khoa?.TenKhoa</dd></dl>
<form asp-action="Delete" method="post"><input type="hidden" name="id" value="@Model.MaSinhVien"/><button class="btn btn-danger">Xác nhận xóa</button> <a asp-action="Index" class="btn btn-secondary">Hủy</a></form>
