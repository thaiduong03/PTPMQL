@model IEnumerable<DemoMVC.Models.SinhVien>

@{
    ViewData["Title"] = "Quản lý sinh viên";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Quản lý sinh viên</h1>
        <p class="text-muted mb-0">Danh sách sinh viên và thông tin khoa đang theo học.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">Thêm sinh viên</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Mã sinh viên</th>
                    <th scope="col">Họ và tên</th>
                    <th scope="col">Năm nhập học</th>
                    <th scope="col">Mã hệ</th>
                    <th scope="col">Mã ngành</th>
                    <th scope="col">Khoa</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var sinhVien in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@sinhVien.MaSinhVien</td>
                            <td>@sinhVien.HoTen</td>
                            <td>@sinhVien.NamNhapHoc</td>
                            <td>@sinhVien.MaHeDaoTao</td>
                            <td>@sinhVien.MaNganh</td>
                            <td>@(sinhVien.Khoa?.TenKhoa ?? "Không xác định")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@sinhVien.MaSinhVien" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@sinhVien.MaSinhVien" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-5">
                            Chưa có sinh viên nào. <a asp-action="Create">Thêm sinh viên đầu tiên</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
