@model DemoMVC.Models.Khoa
@{ ViewData["Title"] = "Thêm khoa"; }
<h1>Thêm khoa</h1>
<form asp-action="Create" method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="MaKhoa" class="form-label"></label><input asp-for="MaKhoa" class="form-control"/><span asp-validation-for="MaKhoa" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="TenKhoa" class="form-label"></label><input asp-for="TenKhoa" class="form-control"/><span asp-validation-for="TenKhoa" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MoTa" class="form-label"></label><textarea asp-for="MoTa" class="form-control"></textarea><span asp-validation-for="MoTa" class="text-danger"></span></div>
<button class="btn btn-success">Lưu</button> <a asp-action="Index" class="btn btn-secondary">Quay lại</a></form>
@section Scripts { <partial name="_ValidationScriptsPartial"/> }
