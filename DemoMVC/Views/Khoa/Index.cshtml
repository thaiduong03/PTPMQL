@model IEnumerable<DemoMVC.Models.Khoa>

@{
    ViewData["Title"] = "Quản lý khoa";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Quản lý khoa</h1>
        <p class="text-muted mb-0">Danh sách khoa và số sinh viên thuộc từng khoa.</p>
    </div>
    <a asp-action="Create" class="btn btn-success">Thêm khoa</a>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-striped table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th scope="col">Mã khoa</th>
                    <th scope="col">Tên khoa</th>
                    <th scope="col">Mô tả</th>
                    <th scope="col" class="text-center">Sinh viên</th>
                    <th scope="col" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var khoa in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@khoa.MaKhoa</td>
                            <td>@khoa.TenKhoa</td>
                            <td>@(string.IsNullOrWhiteSpace(khoa.MoTa) ? "—" : khoa.MoTa)</td>
                            <td class="text-center">@khoa.SinhViens.Count</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@khoa.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                                <a asp-action="Delete" asp-route-id="@khoa.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-5">
                            Chưa có khoa nào. <a asp-action="Create">Thêm khoa đầu tiên</a>.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
