<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DemoMVC</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS mặc định của project -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- CSS tự sinh từ Razor -->
    <link rel="stylesheet"
          href="~/DemoMVC.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- =========================
         NAVBAR
         ========================= -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container">

                <!-- Logo -->
                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    DemoMVC
                </a>

                <!-- Nút menu trên màn hình nhỏ -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <!-- Menu -->
                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Trang chủ -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <!-- Sản phẩm -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Index">
                                Sản phẩm
                            </a>
                        </li>

                        <!-- Danh sách -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="List">
                                Danh sách
                            </a>
                        </li>

                        <!-- Thêm sản phẩm -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Product"
                               asp-action="Create">
                                Thêm sản phẩm
                            </a>
                        </li>

                        <!-- Privacy -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <!-- =========================
         MAIN CONTENT
         ========================= -->
    <main role="main" class="container py-4">

        @RenderBody()

    </main>


    <!-- =========================
         FOOTER
         ========================= -->
    <footer class="border-top bg-white mt-5">

        <div class="container py-3 text-center text-muted">

            &copy; 2026 - DemoMVC -

            <a asp-controller="Home"
               asp-action="Privacy"
               class="text-decoration-none">
                Privacy
            </a>

        </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap 5 -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- JavaScript của project -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- Script riêng của từng View nếu có -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>