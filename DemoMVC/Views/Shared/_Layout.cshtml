﻿@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();

    string NavClass(string ctrl, string? act = null)
    {
        bool isActive = controller == ctrl && (act == null || action == act);
        return isActive ? "nav-link active" : "nav-link";
    }
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - DemoMVC</title>

    <!-- Bootstrap 5 -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- CSS mặc định của project -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <!-- CSS tự sinh từ Razor -->
    <link rel="stylesheet"
          href="~/DemoMVC.styles.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <!-- =========================
         NAVBAR
         ========================= -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm">

            <div class="container">

                <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">
                    DemoMVC
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <li class="nav-item">
                            <a class="@NavClass("Home", "Index")"
                               asp-controller="Home"
                               asp-action="Index">
                                Trang chủ
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavClass("Product", "Index")"
                               asp-controller="Product"
                               asp-action="Index">
                                Sản phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavClass("Product", "List")"
                               asp-controller="Product"
                               asp-action="List">
                                Danh sách
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavClass("Product", "Create")"
                               asp-controller="Product"
                               asp-action="Create">
                                Thêm sản phẩm
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="@NavClass("Home", "Privacy")"
                               asp-controller="Home"
                               asp-action="Privacy">
                                Privacy
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>
    </header>


    <!-- =========================
         MAIN CONTENT
         ========================= -->
    <main role="main" class="container py-4">

        @RenderBody()

    </main>


    <!-- =========================
         FOOTER
         ========================= -->
    <footer class="border-top bg-white">

        <div class="container py-3 text-center text-muted">

            &copy; @DateTime.Now.Year - DemoMVC -

            <a asp-controller="Home"
               asp-action="Privacy"
               class="text-decoration-none">
                Privacy
            </a>

        </div>

    </footer>


    <!-- =========================
         JAVASCRIPT
         ========================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>