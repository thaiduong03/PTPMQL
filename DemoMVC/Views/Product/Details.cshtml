@model DemoMVC.Models.Product

@{
    ViewData["Title"] = "Product Details";
}

<h1>Chi tiết sản phẩm</h1>

@if (Model == null)
{
    <div class="alert alert-warning">
        Chưa có sản phẩm.
        Vui lòng tạo sản phẩm trước.
    </div>
}
else
{
    @* ViewBag *@
    @if (ViewBag.Message != null)
    {
        <div class="alert alert-success">
            <strong>ViewBag:</strong> @ViewBag.Message
        </div>
    }

    @* ViewData *@
    @if (ViewData["ProductName"] != null)
    {
        <div class="alert alert-info">
            <strong>ViewData:</strong> @ViewData["ProductName"]
        </div>
    }

    @* TempData *@
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-primary">
            <strong>TempData:</strong> @TempData["SuccessMessage"]
        </div>
    }

    <hr />

    <p>
        <strong>ID:</strong> @Model.Id
    </p>

    <p>
        <strong>Tên sản phẩm:</strong> @Model.Name
    </p>

    <p>
        <strong>Giá:</strong> @Model.Price.ToString("N0") VNĐ
    </p>

    <p>
        <strong>Mô tả:</strong> @Model.Description
    </p>
}