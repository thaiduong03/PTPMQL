@{
    ViewData["Title"] = "Danh sách sản phẩm";
}

<div class="container">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="page-title mb-1">Danh sách sản phẩm</h1>
            <p class="text-muted mb-0">
                Danh sách các sản phẩm trong hệ thống
            </p>
        </div>

        <a asp-controller="Product"
           asp-action="Create"
           class="btn btn-success">
            + Thêm sản phẩm
        </a>
    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-dark text-white">
            <strong>Sản phẩm</strong>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Tên sản phẩm</th>
                            <th>Giá</th>
                            <th>Mô tả</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        <tr>
                            <td>1</td>
                            <td>iPhone 17</td>
                            <td>20.000.000 VNĐ</td>
                            <td>Điện thoại Apple</td>
                            <td>
                                <a asp-controller="Product"
                                   asp-action="Details"
                                   class="btn btn-sm btn-primary">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>

                        <tr>
                            <td>2</td>
                            <td>MacBook</td>
                            <td>30.000.000 VNĐ</td>
                            <td>Laptop Apple</td>
                            <td>
                                <a asp-controller="Product"
                                   asp-action="Details"
                                   class="btn btn-sm btn-primary">
                                    Chi tiết
                                </a>
                            </td>
                        </tr>

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>